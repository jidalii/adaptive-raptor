# Copy to .env and fill in. Never commit .env.
# Answer generator (OpenAI-compatible API). DeepSeek is the provisional default.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Only needed if an OpenAI model is configured (generation, summarization, or embeddings).
OPENAI_API_KEY=

# Optional: Hugging Face cache location for sentence-transformers models.
# HF_HOME=~/.cache/huggingface
